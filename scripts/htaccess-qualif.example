# Fallback SPA pour déploiement sous un sous-chemin (ex. /qlf-gdp/)
# Copié en dist/.htaccess par npm run build:qualif
# Ne configure pas les proxies /__sso ni /__gdp-pdf (VirtualHost, voir apache-qlf-gdp.conf.example).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /qlf-gdp/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} ^/qlf-gdp/__gdp-pdf [NC,OR]
  RewriteCond %{REQUEST_URI} ^/qlf-gdp/__sso/ [NC]
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /qlf-gdp/index.html [L]
</IfModule>
