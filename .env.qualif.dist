# Build web pour déploiement sous un sous-chemin (ex. /qlf-gdp/)
# Copier vers .env.qualif (non versionné) et adapter les valeurs.
# Les secrets OAuth / API viennent de .env ou .env.qualif.local.

VITE_BASE_PATH=/qlf-gdp/
VITE_USE_QUALIF=true
# Doit matcher Keycloak Valid Redirect URI
VITE_OAUTH_WEB_REDIRECT_URI=

VITE_GDP_REPORT_COMMUNITY_ID=
VITE_GDP_REPORT_DISPLAY_THEMES=
VITE_GDP_REPORT_SUBMISSION_THEME=

# News / alertes au démarrage
# VITE_GDP_NEWS_URL=

# Matomo — utiliser un site dédié qualif si besoin (évite de polluer la prod)
# VITE_MATOMO_URL=
# VITE_MATOMO_SITE_ID=

